import re
text = input("Enter a text document: ")

print("\nOriginal Text:")
print(text)

text = text.lower()

text = re.sub(r'[^a-z\s]', '', text)

print("\nAfter Lowercase and Cleaning:")
print(text)

words = text.split()

print("\nTokenized Words:")
print(words)

stop_words = [
    'is', 'am', 'are', 'the', 'a', 'an',
    'and', 'or', 'but', 'in', 'on', 'at',
    'to', 'for', 'of', 'from', 'with',
    'it', 'this', 'that', 'was', 'were',
    'be', 'been', 'being', 'has', 'have',
    'had', 'do', 'does', 'did'
]

filtered_words = []

for word in words:
    if word not in stop_words:
        filtered_words.append(word)

print("\nAfter Stop Word Removal:")
print(filtered_words)

def stemming(word):
    suffixes = [
        'ingly', 'edly', 'ing', 'ed',
        'ly', 'es', 's'
    ]

    for suffix in suffixes:
        if word.endswith(suffix) and len(word) > len(suffix) + 2:
            word = word[:-len(suffix)]
            break

    return word

stemmed_words = []

for word in filtered_words:
    stemmed_words.append(stemming(word))

print("\nAfter Stemming:")
print(stemmed_words)

final_text = " ".join(stemmed_words)

print("\nFinal Pre-processed Text:")
print(final_text)

